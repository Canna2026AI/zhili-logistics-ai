{
  "name": "zhili-logistics-ai",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.22.0 <25",
    "pnpm": ">=11.5.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:ops": "pnpm --filter @zhili/ops dev",
    "dev:customer": "pnpm --filter @zhili/customer-portal dev",
    "dev:pda": "pnpm --filter @zhili/pda dev",
    "dev:platform": "pnpm --filter @zhili/platform dev",
    "dev:website": "pnpm --filter @zhili/website dev",
    "storybook": "pnpm --filter @zhili/storybook dev",
    "lint": "turbo run lint && markdownlint-cli2 '**/*.md'",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:compose": "sh infra/scripts/smoke.sh",
    "test:ui": "pnpm --filter @zhili/ui test",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:lint": "pnpm --filter @zhili/contracts lint",
    "contracts:test": "pnpm --filter @zhili/contracts test",
    "contracts:generate:check": "pnpm --filter @zhili/contracts generate:check",
    "hooks:install": "simple-git-hooks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.0",
    "@nestjs/common": "^11.1.28",
    "@playwright/test": "^1.61.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@zhili/auth": "workspace:*",
    "@zhili/db": "workspace:*",
    "axe-core": "^4.11.0",
    "bullmq": "5.80.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.5.0",
    "ioredis": "5.11.1",
    "jsdom": "^27.2.0",
    "markdownlint-cli2": "^0.20.0",
    "postgres": "^3.4.9",
    "prettier": "^3.7.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit $1"
  }
}
