{
  "name": "@zhili/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test ../../tests/integration/outbox-worker.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. apps/worker/test/outbox.processor.test.ts tests/integration/outbox-worker.test.ts --exclude '**/.worktrees/**' --no-file-parallelism --testTimeout=30000 --hookTimeout=120000",
    "test:integration": "vitest run --root ../.. tests/integration/outbox-worker.test.ts --exclude '**/.worktrees/**' --no-file-parallelism --testTimeout=30000 --hookTimeout=120000"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@zhili/config": "workspace:*",
    "@zhili/observability": "workspace:*",
    "bullmq": "^5.80.10",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@testcontainers/postgresql": "^12.0.4",
    "esbuild": "^0.28.1",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1"
  }
}
