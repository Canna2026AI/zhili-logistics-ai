{
  "name": "@zhili/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "tsx dist/main.js",
    "lint": "eslint src test ../../tests/integration/idempotency.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run test --exclude 'test/*.e2e.test.ts'",
    "test:e2e": "vitest run test/health.e2e.test.ts test/openapi-coverage.test.ts --no-file-parallelism --testTimeout=30000 --hookTimeout=120000",
    "test:integration": "vitest run --root ../.. tests/integration/idempotency.test.ts --no-file-parallelism --testTimeout=30000 --hookTimeout=120000",
    "integration": "pnpm test:integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@zhili/auth": "workspace:*",
    "@zhili/config": "workspace:*",
    "@zhili/db": "workspace:*",
    "@zhili/observability": "workspace:*",
    "fastify": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@testcontainers/postgresql": "^12.0.4",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1",
    "yaml": "^2.9.0"
  }
}
